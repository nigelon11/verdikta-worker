    "report-info": {
      "type": "Text",
      "props": {
        "text": "File: .pending-verdikta/files/164/report.md (12.8KB, single markdown file)",
        "variant": "body"
      }
    },
    "report-flow-block": {
      "type": "Stack",
      "props": {
        "direction": "vertical",
        "gap": "sm"
      },
      "children": [
        "report-flow-label",
        "report-flow-text"
      ]
    },
    "report-flow-label": {
      "type": "Text",
      "props": {
        "text": "Full flow covered:",
        "variant": "caption"
