        "detail-status"
      ]
    },
    "detail-fork": {
      "type": "Text",
      "props": {
        "text": "Forked Aeon framework and deliberately kept verdikta-hunter alive after upstream sync dropped it",
        "variant": "body"
      }
    },
    "detail-preservation": {
      "type": "Text",
