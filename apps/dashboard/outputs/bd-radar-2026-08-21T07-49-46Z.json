    "lead-class-badge": {
      "type": "Badge",
      "props": {
        "text": "integrating-class lead",
        "variant": "secondary"
      }
    },
    "details-section": {
      "type": "Stack",
      "props": {
        "direction": "vertical",
        "gap": "sm"
      },
      "children": [
        "detail-fork",
