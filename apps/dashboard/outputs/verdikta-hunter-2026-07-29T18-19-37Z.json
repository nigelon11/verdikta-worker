          ],
          [
            "file_size (12.8KB)",
            "✓"
          ],
          [
            "non_empty",
            "✓"
          ],
          [
            "file_readable",
            "✓"
          ],
          [
            "oracle_readable",
            "✓"
          ]
        ]
      }
