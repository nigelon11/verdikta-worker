    "report-flow-text": {
      "type": "Text",
      "props": {
        "text": "register → bundle upload → prepare → bundle/complete → confirm → payable start → finalize",
        "variant": "body"
      }
    },
    "report-modes-block": {
      "type": "Stack",
      "props": {
        "direction": "vertical",
        "gap": "sm"
      },
      "children": [
        "report-modes-label",
        "report-modes-text",
        "report-validation"
      ]
    },
    "report-modes-label": {
      "type": "Text",
      "props": {
        "text": "Failure modes (6 named):",
        "variant": "caption"
      }
