      "props": {
        "title": "Svector-anu/svectors-lab",
        "href": "https://github.com/Svector-anu/svectors-lab",
        "source": "GitHub"
      }
    },
    "operator-badges": {
      "type": "Stack",
      "props": {
        "direction": "horizontal",
        "gap": "md"
      },
      "children": [
        "operator-badge",
        "lead-class-badge"
      ]
    },
    "operator-badge": {
      "type": "Badge",
