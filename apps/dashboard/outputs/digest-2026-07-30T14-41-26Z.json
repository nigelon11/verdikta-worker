      "props": {
        "text": "zerohash launches an Agentic Finance Suite with metered, per-use billing",
        "level": "h3"
      }
    },
    "story2_desc": {
      "type": "Text",
      "props": {
        "text": "zerohash announced its Agentic Finance Suite (hold/move/stream onchain money) and joined the x402 Foundation, adding a Payments Streaming Engine that meters and settles incremental payments — aimed at data feeds, API monetization, and agent-to-agent commerce across 40+ protocols and 100+ assets."
      }
    },
