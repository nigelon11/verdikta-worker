{
  "root": "card-main",
  "state": {},
  "elements": {
    "card-main": {
      "type": "Card",
      "props": {
        "title": "Verdikta Hunter — Dry-run #164"
      },
      "children": [
        "status",
        "bounty-stack",
        "report-stack",
        "checks-stack",
        "tracked-stack",
        "spend-alert"
      ]
    },
    "status": {
      "type": "Alert",
      "props": {
        "type": "success",
        "title": "VALID",
        "message": "Dry-run validation passed, no transactions sent."
      }
    },
    "bounty-stack": {
      "type": "Stack",
      "props": {
        "direction": "vertical",
        "gap": "md"
      },
      "children": [
        "bounty-heading",
        "bounty-desc",
        "bounty-table"
      ]
    },
    "bounty-heading": {
      "type": "Heading",
      "props": {
        "text": "Bounty #164",
        "level": "h3"
      }
    },
    "bounty-desc": {
      "type": "Text",
      "props": {
        "text": "Write an integration guide for submitting to Verdikta bounties from an autonomous agent",
        "variant": "lead"
      }
    },
    "bounty-table": {
      "type": "Table",
      "props": {
        "columns": [
          "Field",
          "Value"
        ],
        "rows": [
          [
            "Reward",
            "0.004 ETH"
          ],
          [
            "Threshold",
            "80%"
          ],
          [
            "Prior Submissions",
            "0"
          ],
          [
            "Time Remaining",
            "~96h"
          ]
        ]
      }
    },
    "report-stack": {
      "type": "Stack",
      "props": {
        "direction": "vertical",
        "gap": "md"
      },
