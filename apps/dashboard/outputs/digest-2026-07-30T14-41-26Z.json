    "story1_title": {
      "type": "Heading",
      "props": {
        "text": "MoonPay ships PayBox, a payment vault Claude and ChatGPT can spend from",
        "level": "h3"
      }
    },
    "story1_desc": {
      "type": "Text",
      "props": {
        "text": "MoonPay launched PayBox on July 29 — a non-custodial wallet that lets ChatGPT and Claude execute crypto trades, swaps, DeFi deposits, and bookings directly from a conversation. Keys are MPC/TEE-split so neither MoonPay nor the AI holds a complete key; it ships day-one on 8 chains including Base and Solana."
      }
    },
    "story1_why": {
      "type": "Stack",
      "props": {
        "direction": "vertical",
        "gap": "sm"
      },
      "children": [
        "story1_why_label",
        "story1_why_text"
      ]
    },
    "story1_why_label": {
      "type": "Text",
      "props": {
        "text": "Why it matters",
        "variant": "lead"
      }
    },
    "story1_why_text": {
      "type": "Text",
      "props": {
        "text": "it's a mainstream consumer product treating the LLM as the transaction initiator, not just an advisor — and it's live with Base support now, not roadmapped."
      }
    },
    "story1_link": {
      "type": "Link",
      "props": {
