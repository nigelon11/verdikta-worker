    "report-modes-text": {
      "type": "Text",
      "props": {
        "text": "BOUNTY_NOT_ONCHAIN, underfunded start, skipped confirm, archive attachments, premature finalize, jobId/bountyId drift",
        "variant": "body"
      }
    },
    "report-validation": {
      "type": "Text",
      "props": {
        "text": "Cross-checked against live /api/docs and agents.txt responses for no_fabrication gate",
        "variant": "caption"
